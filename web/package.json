{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "vite build --mode pwa",
    "deploy": "vite build --mode github && gh-pages -d dist-pwa",
    "deploy:pi": "export $(grep '=' .env.local | xargs) && npm run build:pwa && rsync -rlvz --delete dist-pwa/ $VITE_PI_SSH_USERNAME@$VITE_PI_ADDRESS:/var/www/html/ && open http://$VITE_PI_ADDRESS",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vite-plugin-compression2": "^2.5.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
